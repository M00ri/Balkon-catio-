{
 "steps": [
  {
   "n": 1,
   "titel": "Bestand",
   "text": "Dein Balkon aus dem LiDAR-Scan, gerade ausgerichtet. Innen ca. 3,00 m lang und 1,91 m tief, Brüstung 67 cm hoch, nach oben offen. Unter dem Fenstersturz sind 2,39 m Platz."
  },
  {
   "n": 2,
   "titel": "Bodenschwellen",
   "text": "Drei Kanthölzer 45×70 in U-Form auf den Boden legen: entlang Gartenbrüstung, Stirnbrüstung und Seitenwand. Gummipads darunter schützen die Fliesen und lassen Wasser ablaufen. Die Fensterseite bleibt frei."
  },
  {
   "n": 3,
   "titel": "Pfosten",
   "text": "Fünf Pfosten 70×70 auf die Schwellen stellen und mit Winkelverbindern verschrauben. Die beiden Pfosten an der Glasfront stehen direkt vor der Rinne, damit sie frei bleibt."
  },
  {
   "n": 4,
   "titel": "Oberer Rahmen",
   "text": "Rähm 45×70 rundum auf die Pfosten, Oberkante 2,30 m. Das lässt 9 cm Luft unter dem Fenstersturz."
  },
  {
   "n": 5,
   "titel": "Sparren und Kopfbänder",
   "text": "Zwei Dachsparren tragen das Dachnetz. Kopfbänder 45×45 unter 45° steifen den Rahmen in Längs- und Querrichtung aus, damit er nicht wackelt."
  },
  {
   "n": 6,
   "titel": "Brüstungsklemmen",
   "text": "U-Bügel aus Brettern 20×100 über die Brüstung, an den Pfosten verschraubt. Sie halten das Gestell gegen Wind, ohne dass ins Mauerwerk gebohrt wird."
  },
  {
   "n": 7,
   "titel": "Netz an den Seiten",
   "text": "Katzenschutznetz innen an Pfosten, Schwellen und Rähm tackern oder mit Kabelbindern befestigen. An der Seitenwand nur die Lücke zwischen Wandende und Gartenseite schließen."
  },
  {
   "n": 8,
   "titel": "Dach und Fassadenanschluss",
   "text": "Netz über Rähm und Sparren spannen. Den Spalt zwischen Rahmen und Fenstersturz mit einem Netzstreifen schließen, je nach Erlaubnis geklebt oder geklemmt."
  }
 ],
